# Settings for the reader account only (docker-compose.reader.yml).
# Docker reads ./.env first and this file second, so every line here wins.
# Copy it to .env.reader on the server and fill in the two app values from
# my.telegram.org (the app made with the reader's own phone). Never commit
# .env.reader: it holds a secret.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# reader_db for a fresh login (the owner's choice, 26 Nov 2026).
# ad_db only if the old session were moved instead.
DB_DATABASE=reader_db

# No listener exists for the reader yet. With these on, its updates would
# pile up in the main server's Redis, which has no memory limit.
AUTO_START=false
HANDLE_OLD_DATA=false

# The reader only reads channels: upstream says to turn the min database off
# for that. The file reference database stays on, or photo downloads break.
DB_ENABLE_MIN_DATABASE=false
DB_ENABLE_FILE_REFERENCE_DATABASE=true

# Errors and warnings.
LOGGER_LEVEL=2
